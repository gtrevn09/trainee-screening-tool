@model IEnumerable<TraineeScreeningTool.Models.Candidate>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3 sidebar">
            <h4 class="mt-3">LIFE Staff Portal</h4>
            <hr>
            <nav class="nav flex-column">
                <a class="nav-link text-white active" href="/">Dashboard</a>
                <a class="nav-link text-white" href="#">All Candidates</a>
                <a class="nav-link text-white" href="#">Historical Data</a>
            </nav>
        </div>

        <div class="col-md-9 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Candidate Screening</h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCandidateModal">
                    + Add Candidate
                </button>
            </div>

            <div class="card p-3">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Current Recommendation</th>
                            <th>Rating</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.Name</strong><br><small class="text-muted">@item.Email</small></td>
                                    <td>
                                        @if (item.Recommendation != "Pending")
                                        {
                                            <span class="badge bg-success">@item.Recommendation</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Recommendation</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var ratingColor = item.ReadinessRating == "High" ? "text-success" : "text-dark";
                                        }
                                        <span class="@ratingColor fw-bold">@item.ReadinessRating</span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <div class="btn-group">
                                                <a asp-action="Assess" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-dark">Assess</a>
                                                <a asp-action="Details" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-info text-white">View Report</a>
                                            </div>
                                            
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" 
                                                  onsubmit="return confirm('Are you sure you want to delete @item.Name?');">
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No candidates found. Add one to get started.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addCandidateModal" tabindex="-1" aria-labelledby="addCandidateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCandidateModalLabel">Register New Candidate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="Name" class="form-control" required placeholder="e.g. Jordan Charlie">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="Email" class="form-control" required placeholder="jordan@example.com">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Candidate</button>
                </div>
            </form>
        </div>
    </div>
</div>