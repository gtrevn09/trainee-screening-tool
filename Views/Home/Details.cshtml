@model TraineeScreeningTool.Models.Candidate

<div class="container mt-5">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between">
            <h4 class="mb-0">Screening Report: @Model.Name</h4>
            <span class="badge bg-light text-primary">ID: @Model.Id</span>
        </div>
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-md-4">
                    <h6>Recommended Pathway</h6>
                    <h3 class="text-primary">@Model.Recommendation</h3>
                </div>
                <div class="col-md-4">
                    <h6>Readiness Rating</h6>
                    <h4 class="text-@(Model.ReadinessRating == "High" ? "success" : "warning")">
                        @Model.ReadinessRating
                    </h4>
                </div>
            </div>

            <div class="alert alert-info">
                <h5><i class="bi bi-info-circle"></i> System Explanation</h5>
                <p class="mb-0">@Model.Explanation</p>
            </div>

            <table class="table table-bordered mt-4">
                <thead class="table-light">
                    <tr>
                        <th>Assessment Category</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>IT Aptitude</td><td>@Model.ITScore%</td></tr>
                    <tr><td>Carpentry / Manual Dexterity</td><td>@Model.CarpentryScore%</td></tr>
                    <tr><td>Bookkeeping / Math</td><td>@Model.BookkeepingScore%</td></tr>
                </tbody>
            </table>

            <div class="mt-4 no-print">
                <a href="/" class="btn btn-outline-secondary">Back to Dashboard</a>
                <button onclick="window.print()" class="btn btn-dark">Print Report</button>
            </div>
        </div>
    </div>
</div>